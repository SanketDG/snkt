---
import Base from "../layouts/Base.astro"
import ProjectCard from "../components/ProjectCard.astro"
import { recent, earlier } from "../data/projects"
---

<Base title="Projects" description="Things Sanket Dasgupta has built.">
  <h1>Projects</h1>

  <h2>Recent</h2>
  <ul class="cards cards-2">
    {
      recent.map((project) => (
        <li>
          <ProjectCard {...project} />
        </li>
      ))
    }
  </ul>

  <h2>Earlier</h2>
  <ul class="cards cards-2">
    {
      earlier.map((project) => (
        <li>
          <ProjectCard {...project} />
        </li>
      ))
    }
  </ul>
</Base>
