---
import Base from "../layouts/Base.astro"
import ObfuscatedEmail from "../components/ObfuscatedEmail.astro"

// Content mirrors resume.tex in github.com/SanketDG/resume. Text between ** ** renders bold.
const experience = [
  {
    title: "Fynd (Acquired by Reliance)",
    meta: "Mar 2021 – Present • SDE 3 • Bangalore, India",
    points: [
      "Built and scaled Serviceability and Logistics services for multiple Reliance Jio E-Commerce projects (including Tira and Jiomart) from 0-1M users, **responsible for algorithmic store and shipment assignment, accurate delivery-date computation, and delivery-partner allocation** via partner APIs.",
      "Led the implementation of **Rule Engines and Geographical Zones with CRUD APIs, functional execution, and UIs giving sellers customization over store, shipment, and delivery-partner selection.**",
      "Built a QuickCommerce PoC with **polygon-based serviceability that enabled Jiomart's 10-minute deliveries, then evolved into a multi-promise fulfillment engine supporting Quick Commerce, Rush, Same-Day, and Next-Day modes with flexible seller configurations**, adopted across Tira Express, Jiomart Quick, and Ajio Rush.",
      "Architected Ajio's **Exchange Anything flow across Payments, Cart, OMS, and Serviceability in 10 days**, with multiple seller configurations and shipped end-to-end flows in both the Web (React) and Mobile (React Native) apps.",
      "**Achieved 95% optimization in customer-facing Serviceability APIs** by implementing serialization improvements (orjson), validation migration (Pydantic), async Redis, HTTP session pooling, N+1 query fixes, and DB query batching. Layered in-memory caching (alru_cache) across all components on top of Redis and built a rule invalidation engine using Redis pub/sub.",
      "Ported the **customer-facing layer of Serviceability from Python to Go, achieving 60% further latency reduction.** Rolled out incrementally using canary deployments, and ported E2E integration tests from the Python service to validate response parity, ensuring 100% compatibility before full cutover.",
      "Mentored 15 team members across Reliance projects, **led code and solution reviews, drove QA and SRE alignment, and owned release coordination** for the platform powering all Reliance E-Commerce.",
    ],
  },
  {
    title: "Persistent Systems",
    meta: "Aug 2018 – Feb 2021 • Software Engineer • Pune, India",
    points: [
      "Migrated an enterprise email product to the cloud via a Chrome Extension/Outlook Addin, and refactored the backend with async worker queues and Redis, achieving a 4x performance improvement.",
    ],
  },
  {
    title: "Google Summer of Code",
    meta: "April 2016 – August 2016 • Open Source Developer",
    points: [
      "Built language-independent documentation extraction and auto-fix tooling for the Python Software Foundation (coala).",
    ],
  },
]

const skills = [
  { title: "Proficient in", items: ["Python", "Go", "Javascript (ES6)", "Typescript"] },
  { title: "Frameworks/Libraries", items: ["FastAPI", "Sanic", "Node.js", "Vue.js", "React.js"] },
  { title: "Databases/Datastores", items: ["MongoDB", "Redis", "Kafka", "MySQL"] },
  { title: "Tools", items: ["Webpack", "Docker", "Git"] },
  { title: "Reliability", items: ["Kubernetes", "Prometheus", "Grafana", "GCP"] },
]

const projects = [
  {
    name: "djurl",
    tech: "Python • Django • Docker",
    link: "https://github.com/SanketDG/djurl",
    text: "A minimal self-hosted URL shortener built with best practices for modern Python tooling around Django.",
  },
  {
    name: "khol",
    tech: "C",
    link: "https://github.com/SanketDG/khol",
    text: "A minimalistic shell written in C with support for redirection, history and pipes.",
  },
]

const achievements = [
  {
    title: "Mentor for Google Summer of Code 2017 and 2020",
    date: "May 2020",
    text: "Mentored a GSoC student for the coala and Anita-B organization in respective years.",
  },
  {
    title: "2nd Place at HackerEarth IndiaHacks Open Source Hackathon",
    date: "March 2016",
    text: "Contributed to various open source projects to reach the leaderboard on the basis of difficulty of issues triaged.",
  },
]
---

<Base title="Resume" description="Resume of Sanket Dasgupta, software engineer.">
  <div class="resume">
    <header>
      <h1>Sanket Dasgupta</h1>
      <p>
        <ObfuscatedEmail user="sanketdasgupta" domain="gmail.com" fallback="https://www.linkedin.com/in/sanketdg" /> • India • <a href="https://github.com/SanketDG">github.com/SanketDG ↗</a> • <a href="https://snkt.vercel.app">snkt.vercel.app ↗</a>
      </p>
    </header>

    <div class="cols">
      <section>
        <h2>Experience</h2>
        {
          experience.map((job) => (
            <div class="entry">
              <h3>{job.title}</h3>
              <p class="sub">{job.meta}</p>
              <ul class="points">
                {job.points.map((point) => (
                  <li>{point.split("**").map((part, i) => (i % 2 ? <strong>{part}</strong> : part))}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </section>

      <section>
        <h2>Skills</h2>
        {
          skills.map((group) => (
            <div class="entry">
              <h3>{group.title}</h3>
              <ul class="chips">
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </section>

      <section>
        <h2>Projects</h2>
        {
          projects.map((project) => (
            <div class="entry">
              <h3><a href={project.link}>{project.name} ↗</a></h3>
              <p class="sub">{project.tech}</p>
              <p>{project.text}</p>
            </div>
          ))
        }
      </section>

      <section>
        <h2>Achievements</h2>
        {
          achievements.map((item) => (
            <div class="entry">
              <h3 class="caps">{item.title}</h3>
              <p class="sub">{item.date}</p>
              <p>{item.text}</p>
            </div>
          ))
        }
      </section>

      <section>
        <h2>Education</h2>
        <div class="entry">
          <h3>Academy of Technology</h3>
          <p class="sub">B. Tech Computer Science • Kolkata, India • June 2018</p>
          <p>GPA: 8.1</p>
        </div>
      </section>
    </div>
  </div>
</Base>

<style>
  .resume {
    max-width: 66rem;
    margin: 0 auto;
  }

  header {
    margin-bottom: 1.75rem;
    text-align: center;
  }

  header h1 {
    margin: 0 0 0.25rem;
    font: 600 1.75rem var(--sans);
  }

  header p {
    margin: 0;
  }

  .cols {
    column-gap: 2.25rem;
  }

  @media (min-width: 52rem) {
    .cols {
      columns: 2;
    }
  }

  section {
    margin-bottom: 1.5rem;
  }

  h2 {
    margin: 0 0 0.75rem;
    break-after: avoid;
    font: 700 1.1rem var(--sans);
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .entry {
    margin-bottom: 1rem;
    break-inside: avoid;
  }

  h3 {
    margin: 0 0 0.25rem;
    font: 600 1.05rem/1.3 var(--sans);
  }

  h3 a {
    color: inherit;
  }

  h3.caps {
    font-size: 0.9rem;
    text-transform: uppercase;
  }

  p {
    margin: 0 0 0.5rem;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .sub {
    color: var(--muted);
  }

  .points {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .points li {
    position: relative;
    margin-top: 0.5rem;
    padding-left: 0.9rem;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .points li::before {
    content: "›";
    position: absolute;
    left: 0;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .chips li {
    padding: 0 0.6rem;
    border: 2px solid var(--fg);
    font-size: 0.9rem;
  }

  @media print {
    :global(.site-header),
    :global(.site-footer) {
      display: none;
    }

    :global(.wrap) {
      max-width: none;
      padding: 0;
    }

    header {
      margin-bottom: 8pt;
    }

    header h1 {
      font-size: 16pt;
    }

    .cols {
      columns: 2;
      column-gap: 0.3in;
    }

    section {
      margin-bottom: 6pt;
    }

    h2 {
      margin-bottom: 4pt;
      font-size: 10pt;
    }

    h3 {
      margin-bottom: 1pt;
      font-size: 10pt;
    }

    h3.caps {
      font-size: 9pt;
    }

    .entry {
      margin-bottom: 6pt;
    }

    p,
    .points li,
    .chips li {
      font-size: 9pt;
      line-height: 1.4;
    }

    p {
      margin-bottom: 3pt;
    }

    .points li {
      margin-top: 2.5pt;
    }

    .chips {
      gap: 3pt;
      margin-top: 3pt;
    }

    .chips li {
      padding: 0 5pt;
      border-width: 1.5px;
    }
  }
</style>
