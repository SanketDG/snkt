---
import { getCollection } from "astro:content"
import Base from "../layouts/Base.astro"
import ProjectCard from "../components/ProjectCard.astro"
import { recent as featured } from "../data/projects"

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
)
const latest = posts.slice(0, 3)
const day = new Intl.DateTimeFormat("en-US", { month: "short", year: "numeric", timeZone: "UTC" })
const built = new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" }).format(new Date())
---

<Base title="Home">
  <section class="hero">
    <p class="eyebrow">Software engineer</p>
    <h1>Hi, I'm Sanket.</h1>
    <p class="lede">
      I build serviceability and logistics systems for Reliance's e-commerce platforms: delivery promises, rule
      engines and quick commerce, mostly in Python and Go.
    </p>
    <p class="actions">
      <a class="button" href="/resume">Resume</a>
    </p>
  </section>

  <section>
    <h2 class="section-title">Right now</h2>
    <ul class="now">
      <li><strong>At work</strong> Fynd, SDE 3: making delivery estimates fast and accurate across Tira, Jiomart and Ajio.</li>
      <li><strong>On the side</strong> SpecWatch, an OpenAPI contract runner in Go, and tooling for working with AI coding agents.</li>
      <li><strong>This site</strong> Rebuilt on Astro. Writing coming next.</li>
    </ul>
    <p class="meta">Updated {built}</p>
  </section>

  <section>
    <div class="section-head">
      <h2 class="section-title">Selected work</h2>
      <a href="/projects">All projects →</a>
    </div>
    <ul class="cards cards-2">
      {
        featured.map((project) => (
          <li>
            <ProjectCard {...project} />
          </li>
        ))
      }
    </ul>
  </section>

  {
    latest.length >= 3 && (
      <section>
        <div class="section-head">
          <h2 class="section-title">Writing</h2>
          <a href="/blog">All posts →</a>
        </div>
        <ul class="posts">
          {latest.map((post) => (
            <li>
              <time datetime={post.data.date.toISOString()}>{day.format(post.data.date)}</time>
              <a href={post.data.path}>{post.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>
