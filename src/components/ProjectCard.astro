---
import Icon from "./Icon.astro"

interface Props {
  name: string
  description: string
  tech?: string[]
  link: string
}

const { name, description, tech = [], link } = Astro.props
---

<article class="card">
  <h3>
    {name}
    <a href={link} aria-label={`${name} on GitHub`}><Icon name="github" size={20} /></a>
  </h3>
  <p>{description}</p>
  {
    tech.length > 0 && (
      <ul class="tags">
        {tech.map((t) => (
          <li>{t}</li>
        ))}
      </ul>
    )
  }
</article>
